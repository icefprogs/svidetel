<Window x:Class="Svidetel.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Свидетель · Инспектор Windows" Width="1380" Height="880" MinWidth="1000" MinHeight="650" Background="#171717" Foreground="#ECECEC" FontSize="13" FontFamily="Segoe UI Variable Text, Segoe UI">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><StackPanel><TextBlock Text="◉  Свидетель" FontSize="30" FontWeight="Bold"/><TextBlock Text="Что работает. Почему запускается. Как взять под контроль." Margin="0,6,0,20" Foreground="#ADADAD"/></StackPanel><TextBlock x:Name="AdminLabel" HorizontalAlignment="Right" Foreground="#D1D1D1" VerticalAlignment="Top" Margin="0,12,0,0"/></Grid>
  <WrapPanel Grid.Row="1" x:Name="Toolbar"><Button Content="Сканировать ПК" Click="ScanClick" Background="#38513F"/><Button Content="Демо" Click="DemoClick"/><Button Content="Проверить папку" Click="FolderClick"/><Button Content="Экспорт отчёта" Click="ExportClick"/><Button Content="Настройки приложений Windows" Click="AppsClick"/><Button Content="Открыть от администратора" Click="AdminClick"/><CheckBox x:Name="WatchEnabled" Content="Следить за возвратом" Foreground="#D1D1D1" VerticalAlignment="Center" Margin="6,0,0,8" ToolTip="Раз в минуту, пока приложение открыто. Уведомление внутри приложения."/></WrapPanel>
  <Border Grid.Row="2" Background="#212121" CornerRadius="28" Padding="16" Margin="0,8,0,16"><TabControl Background="Transparent" BorderThickness="0">
   <TabItem Header=" Обзор компьютера "><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,12,0"><TextBlock Text="ИСТОЧНИКИ" Margin="0,8,0,12" Foreground="#ADADAD"/><ListBox x:Name="Categories" SelectionChanged="FilterChanged" Background="#2B2B2B" Foreground="#ECECEC" BorderThickness="0" Padding="4"/><TextBlock Text="Неизвестный ≠ вредоносный. Все изменения выполняются только по вашему выбору." TextWrapping="Wrap" Margin="0,18,0,0" Foreground="#ADADAD"/></StackPanel>
    <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="3*"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
     <TextBox x:Name="Search" Background="#303030" TextChanged="SearchChanged" ToolTip="Поиск по имени, пути, команде и источнику" Margin="0,0,0,12"/>
     <Border Grid.Row="1" CornerRadius="22" Background="#282828" Padding="8"><DataGrid x:Name="Findings" SelectionChanged="SelectionChanged" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Background="#212121" Foreground="#ECECEC" RowHeaderWidth="0" RowHeight="42" RowBackground="#282828" AlternatingRowBackground="#303030" GridLinesVisibility="None" BorderThickness="0" EnableRowVirtualization="True" CanUserAddRows="False">
      <DataGrid.Columns><DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Источник" Binding="{Binding Category}" Width="110"/><DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="140"/><DataGridTextColumn Header="Действие" Binding="{Binding Recommendation}" Width="2*"/></DataGrid.Columns>
     </DataGrid></Border>
     <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBox x:Name="Details" Background="#2B2B2B" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="Выберите объект для просмотра доказательств и доступных действий."/>
      <WrapPanel Grid.Row="1" Margin="0,10,0,0"><Button x:Name="DisableButton" Content="Отключить запуск…" Click="DisableClick" IsEnabled="False" Background="#5A4141"/><Button x:Name="InspectButton" Content="Подпись и SHA-256" Click="InspectClick" IsEnabled="False"/><Button Content="Копировать сведения" Click="CopyClick"/></WrapPanel>
     </Grid>
    </Grid>
   </Grid></TabItem>
   <TabItem Header=" История и восстановление "><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Исходные параметры сохраняются до изменения. При конфликте восстановление блокируется. prepared / uncertain — операция могла прерваться; используйте восстановление." TextWrapping="Wrap" Margin="0,0,0,16"/><ListBox Grid.Row="1" x:Name="HistoryList" DisplayMemberPath="Label" Background="#2B2B2B" Foreground="#ECECEC"/><WrapPanel Grid.Row="2" Margin="0,12,0,0"><Button x:Name="RestoreButton" Content="Восстановить выбранное…" Click="RestoreClick"/><Button Content="Обновить историю" Click="HistoryClick"/></WrapPanel></Grid></TabItem>
   <TabItem Header=" Изменения и охват "><TextBox x:Name="Coverage" Margin="16" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="Запустите сканирование. Здесь появятся ошибки доступа и различия с предыдущим снимком. Приложение не является антивирусом и не гарантирует обнаружение всех механизмов закрепления."/></TabItem>
  </TabControl></Border>
  <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" Text="Готов к проверке · данные остаются на этом компьютере" TextWrapping="Wrap" Foreground="#ADADAD"/><TextBlock Grid.Column="1" Margin="20,0,0,0" Foreground="#ADADAD">Разработчик: <Hyperlink NavigateUri="https://github.com/icefprogs" RequestNavigate="DeveloperLink" Foreground="#ECECEC">@icefprogs</Hyperlink></TextBlock><Button Grid.Column="2" x:Name="CancelButton" Content="Отменить проверку" Click="CancelClick" Visibility="Collapsed" Margin="12,0,0,0"/></Grid>
 </Grid>
</Window>




